# Copy this file to .env and fill in values.

# --- Server ---
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=true

# --- Database ---
# Use "sqlite" for zero-setup demo mode, or "mysql" for the architecture spec.
DB_BACKEND=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ai_mock_interviewer
# SQLITE_PATH=./ai_mock.db

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- LLM ---
# LLM_PROVIDER: mock (no key needed) | groq | gemini
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Interview ---
QUESTIONS_PER_SESSION=5
RETRIEVAL_TOP_K=3
MAX_UPLOAD_MB=10
